# OpenCatch Production Environment Variables
# Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod

# ── Domain ────────────────────────────────────────────────────
DOMAIN=opencatch.app
CERTBOT_EMAIL=admin@opencatch.app

# ── Database ──────────────────────────────────────────────────
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 16
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# ── JWT Auth ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
