{
  "expo": {
    "name": "OpenCatch",
    "slug": "opencatch",
    "scheme": "opencatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#07111A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.opencatch.mobile"
    },
    "plugins": [
      "expo-font",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "0ab7193d-926e-44e6-9d23-4bd4c8aef6d9"
      }
    }
  }
}
